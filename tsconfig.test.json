{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "app/**/*.ts",
    "configs/**/*.ts",
    "controllers/**/*.ts",
    "database/**/*.ts",
    "lib/**/*.ts",
    "utils/**/*.ts",
    "middlewares/**/*.ts",
    "routes/**/*.ts",
    "schemas/**/*.ts",
    "models/**/*.ts",
    "services/**/*.ts",
    "types/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-worker",
    ".nitro",
    ".output",
    ".output-worker",
    ".vercel",
    "pkg",
    "temp"
  ]
}
